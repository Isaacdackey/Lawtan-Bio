# ===================================================================
# Configuration Base de Donnees Neon PostgreSQL
# ===================================================================
SPRING_DATASOURCE_URL=jdbc:postgresql://<HOST>/<DATABASE>?sslmode=require
SPRING_DATASOURCE_USERNAME=<USERNAME>
SPRING_DATASOURCE_PASSWORD=<PASSWORD>

# ===================================================================
# Hibernate & JPA
# ===================================================================
SPRING_JPA_HIBERNATE_DDL_AUTO=none
DB_POOL_MAX=5

# ===================================================================
# Serveur
# ===================================================================
PORT=8080

# ===================================================================
# Securite & JWT
# ===================================================================
LAWTAN_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
LAWTAN_JWT_EXPIRATION=86400000

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://lawtan.vercel.app,https://lawtan-front.vercel.app

# ===================================================================
# Cloudinary Configuration
# ===================================================================
CLOUDINARY_CLOUD_NAME=<CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<CLOUDINARY_API_SECRET>
CLOUDINARY_FOLDER=lawtan-bio

